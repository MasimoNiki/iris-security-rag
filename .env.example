APP_NAME=IRIS Security RAG
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://iris:iris@127.0.0.1:5433/iris
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=iris_chunks
REDIS_URL=redis://127.0.0.1:6379/0

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150

RETRIEVAL_STRATEGY=hybrid
HYBRID_DENSE_WEIGHT=0.6
HYBRID_LEXICAL_WEIGHT=0.4
HYBRID_RRF_K=60
HYBRID_CANDIDATE_POOL_SIZE=50
BM25_K1=1.5
BM25_B=0.75

RERANKER_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_CANDIDATE_POOL_SIZE=20
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_FAIL_OPEN=true

LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=extractive
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.2
RAG_MIN_RETRIEVAL_SCORE=0.50
RAG_MAX_CONTEXTS=5

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=5m

# Optional OpenAI-compatible provider. Leave empty when using Ollama.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional: increases GitHub API limits for scripts/fetch_corpus_sources.py.
GITHUB_TOKEN=
